{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/grok-4.5",
  "small_model": "opencode-go/grok-4.5",
  "default_agent": "build",
  "agent": {
    "code-executor": {
      "model": "opencode-go/grok-4.5",
      "mode": "subagent",
      "description": "Implements one DeepTrace milestone sub-task with green tests and safe commits"
    },
    "code-reviewer": {
      "model": "opencode-go/grok-4.5",
      "mode": "subagent",
      "description": "Read-only code review against contracts and milestone acceptance"
    },
    "git-commit-reviewer": {
      "model": "opencode-go/grok-4.5",
      "mode": "subagent",
      "description": "Read-only git history and merge-gate review"
    }
  },
  "permission": {
    "external_directory": {
      "/home/arch/repos/deeptrace-m3.1/**": "allow",
      "/home/arch/repos/deeptrace-m3.6/**": "allow",
      "/home/arch/repos/deeptrace-m4/**": "allow",
      "*": "ask"
    }
  }
}
